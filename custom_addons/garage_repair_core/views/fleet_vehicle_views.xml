<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extension Formulaire Véhicule -->
    <record id="view_fleet_vehicle_form_inherit_garage" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.garage</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <!-- Boutons Statistiques Atelier dans button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_receptions" type="object" class="oe_stat_button" icon="fa-file-text-o">
                    <field name="reception_count" widget="statinfo" string="Réceptions"/>
                </button>
                <button name="action_view_repair_orders" type="object" class="oe_stat_button" icon="oi-settings-adjust">
                    <field name="repair_order_count" widget="statinfo" string="Ordres Réparation"/>
                </button>
                <button name="action_view_claims" type="object" class="oe_stat_button" icon="fa-shield">
                    <field name="claim_count" widget="statinfo" string="Sinistres"/>
                </button>
            </xpath>

            <!-- Ajout du Propriétaire sous le modèle -->
            <xpath expr="//field[@name='driver_id']" position="after">
                <field name="customer_id" options="{'no_quick_create': True}"/>
            </xpath>

            <!-- Section Immatriculation Marocaine & Données Châssis -->
            <xpath expr="//group[1]" position="before">
                <!-- Moroccan Plate Badge Preview -->
                <div class="mb-3" invisible="not license_plate">
                    <span class="o_garage_plate">
                        <field name="license_plate" readonly="1"/>
                    </span>
                </div>

                <group string="Immatriculation &amp; Identification Technique" col="4">
                    <field name="plate_type"/>
                    <field name="license_plate" placeholder="Ex: 26 | B | 234556 ou WW-123456"/>
                    <field name="plate_region_part" invisible="plate_type != 'standard'"/>
                    <field name="plate_letter_part" invisible="plate_type != 'standard'"/>
                    <field name="plate_number_part" invisible="plate_type != 'standard'"/>
                    <field name="vin_number" placeholder="17 caractères (Ex: VF7...)"/>
                    <field name="engine_code" placeholder="Ex: 1.6 TDI, 2.0 HDi"/>
                    <field name="transmission"/>
                    <field name="color_car"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Recherche améliorée sur les véhicules avec VIN et Client -->
    <record id="view_fleet_vehicle_search_inherit_garage" model="ir.ui.view">
        <field name="name">fleet.vehicle.search.inherit.garage</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="license_plate"/>
                <field name="vin_number"/>
                <field name="customer_id"/>
                <field name="engine_code"/>
            </xpath>
            <xpath expr="//filter[@name='inactive']" position="after">
                <filter name="group_customer" string="Par Propriétaire" context="{'group_by': 'customer_id'}"/>
                <filter name="group_plate_type" string="Par Type d'Immatriculation" context="{'group_by': 'plate_type'}"/>
            </xpath>
        </field>
    </record>
</odoo>
