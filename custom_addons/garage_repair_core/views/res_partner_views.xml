<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_garage" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.garage</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Bouton Statistique pour les Véhicules possédés -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_vehicles" type="object" class="oe_stat_button" icon="fa-car">
                    <field name="vehicle_count" widget="statinfo" string="Véhicules"/>
                </button>
            </xpath>

            <!-- Masquer le sélecteur natif standard Individual/Company pour éviter la double sélection -->
            <xpath expr="//field[@name='company_type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Rôle Atelier Unifié pour Assistant (Option 1) -->
            <xpath expr="//field[@name='company_type']" position="after">
                <div class="mb-2">
                    <label for="partner_role" class="fw-bold me-2 text-primary" string="Rôle du Contact :"/>
                    <field name="partner_role" widget="radio" options="{'horizontal': true}"/>
                </div>
            </xpath>

            <!-- Identifiants Marocains directs sur la fiche principale (Sans chercher dans les onglets) -->
            <xpath expr="//field[@name='vat']" position="before">
                <field name="cin" placeholder="Ex: BE123456 (Pour client particulier marocain)" invisible="partner_role != 'customer_individual'"/>
                <field name="ice" placeholder="15 chiffres obligatoires (Ex: 001234567000089)" invisible="partner_role == 'customer_individual'"/>
            </xpath>

            <!-- Fiscalité Complémentaire & Rôles Avancés -->
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="Fiscalité Maroc &amp; Rôles Avancés" name="morocco_tax_garage">
                    <group>
                        <group string="Identifiants Fiscaux Société (Obligatoires Facture)" invisible="partner_role == 'customer_individual'">
                            <field name="identifiant_fiscal" placeholder="Numéro IF"/>
                            <field name="registre_commerce" placeholder="Numéro RC &amp; Ville (Ex: 89542 Casablanca)"/>
                            <field name="patente" placeholder="N° Patente professionnelle"/>
                        </group>
                        <group string="Rôles Techniques Système">
                            <field name="is_insurance_company"/>
                            <field name="is_expert_cabinet"/>
                            <field name="is_parts_supplier"/>
                            <field name="customer_type" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Recherche améliorée pour filtrer par ICE, CIN, Assurances, etc. -->
    <record id="view_res_partner_filter_inherit_garage" model="ir.ui.view">
        <field name="name">res.partner.select.inherit.garage</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="ice"/>
                <field name="cin"/>
                <field name="partner_role"/>
            </xpath>
            <xpath expr="//filter[@name='type_person']" position="after">
                <separator/>
                <filter string="Clients Particuliers" name="filter_particulier" domain="[('partner_role', '=', 'customer_individual')]"/>
                <filter string="Sociétés &amp; Flottes" name="filter_company" domain="[('partner_role', '=', 'customer_company')]"/>
                <separator/>
                <filter string="Compagnies d'Assurance" name="filter_insurance" domain="[('is_insurance_company', '=', True)]"/>
                <filter string="Cabinets d'Expertise" name="filter_expert" domain="[('is_expert_cabinet', '=', True)]"/>
                <filter string="Fournisseurs Pièces Détachées" name="filter_parts_supplier" domain="[('is_parts_supplier', '=', True)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Rôle Atelier" name="group_by_partner_role" context="{'group_by': 'partner_role'}"/>
            </xpath>
        </field>
    </record>
</odoo>