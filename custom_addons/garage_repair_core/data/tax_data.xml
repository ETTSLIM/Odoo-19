<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Taxe TVA 20% Maroc Ventes -->
        <record id="tax_tva_20_sale" model="account.tax">
            <field name="name">TVA 20% (Ventes Garage)</field>
            <field name="amount">20.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">sale</field>
            <field name="description">TVA 20%</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Taxe TVA 20% Maroc Achats -->
        <record id="tax_tva_20_purchase" model="account.tax">
            <field name="name">TVA 20% (Achats Pièces)</field>
            <field name="amount">20.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">purchase</field>
            <field name="description">TVA 20% Récupérable</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
    </data>

    <data noupdate="0">
        <!-- Activation Devise Dirham Marocain (MAD / DH) -->
        <record id="base.MAD" model="res.currency">
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
