<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Séquence Réception Atelier -->
        <record id="seq_garage_reception" model="ir.sequence">
            <field name="name">Séquence Réception Atelier</field>
            <field name="code">garage.reception</field>
            <field name="prefix">REC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Séquence Bon de Travail / BL Atelier -->
        <record id="seq_garage_work_order_bl" model="ir.sequence">
            <field name="name">Séquence Bon de Travail Atelier (BL)</field>
            <field name="code">garage.work.order.bl</field>
            <field name="prefix">BL/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Séquence Dossier Sinistre Assurance -->
        <record id="seq_garage_insurance_claim" model="ir.sequence">
            <field name="name">Séquence Dossier Sinistre Assurance</field>
            <field name="code">garage.insurance.claim</field>
            <field name="prefix">SIN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Séquence Diagnostic Audio Atelier -->
        <record id="seq_garage_diagnostic_log" model="ir.sequence">
            <field name="name">Séquence Diagnostic Audio Atelier</field>
            <field name="code">garage.diagnostic.log</field>
            <field name="prefix">DIAG/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
