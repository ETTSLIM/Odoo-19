<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Catégorie / Privilège Odoo 19 pour le Garage -->
    <record model="res.groups.privilege" id="res_groups_privilege_garage">
        <field name="name">Garage &amp; Atelier Automobile</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <!-- 5 Groupes Granulaires de Visibilité par Module -->
    <record id="group_garage_access_workshop" model="res.groups">
        <field name="name">Accès Module 1 : Atelier &amp; Entrées</field>
        <field name="sequence">1</field>
        <field name="privilege_id" ref="res_groups_privilege_garage"/>
        <field name="implied_ids" eval="[Command.set([ref('base.group_user')])]"/>
    </record>

    <record id="group_garage_access_insurance" model="res.groups">
        <field name="name">Accès Module 2 : Sinistres &amp; Assurances</field>
        <field name="sequence">2</field>
        <field name="privilege_id" ref="res_groups_privilege_garage"/>
        <field name="implied_ids" eval="[Command.set([ref('base.group_user')])]"/>
    </record>

    <record id="group_garage_access_stock" model="res.groups">
        <field name="name">Accès Module 3 : Pièces, Stock Magasin &amp; BL</field>
        <field name="sequence">3</field>
        <field name="privilege_id" ref="res_groups_privilege_garage"/>
        <field name="implied_ids" eval="[Command.set([ref('base.group_user'), ref('stock.group_stock_user')])]"/>
    </record>

    <record id="group_garage_access_finance" model="res.groups">
        <field name="name">Accès Module 4 : Caisse Guichet &amp; Factures Fiscales</field>
        <field name="sequence">4</field>
        <field name="privilege_id" ref="res_groups_privilege_garage"/>
        <field name="implied_ids" eval="[Command.set([ref('base.group_user')])]"/>
    </record>

    <record id="group_garage_access_directory" model="res.groups">
        <field name="name">Accès Module 5 : Parc Véhicules &amp; Annuaire</field>
        <field name="sequence">5</field>
        <field name="privilege_id" ref="res_groups_privilege_garage"/>
        <field name="implied_ids" eval="[Command.set([ref('base.group_user'), ref('fleet.fleet_group_user')])]"/>
    </record>

    <!-- 4 Profils Métiers Garage Pro -->
    <!-- Profil 1 : Mécanicien / Chef d'Atelier (Atelier uniquement) -->
    <record id="group_garage_mechanic" model="res.groups">
        <field name="name">Mécanicien / Opérateur Atelier</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_garage"/>
        <field name="implied_ids" eval="[
            Command.set([
                ref('group_garage_access_workshop'),
                ref('fleet.fleet_group_user'),
                ref('base.group_user')
            ])
        ]"/>
    </record>

    <!-- Profil 2 : Magasinier / Gestionnaire Pièces (Atelier + Stock Magasin & BL) -->
    <record id="group_garage_storekeeper" model="res.groups">
        <field name="name">Magasinier / Gestionnaire Pièces</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_garage"/>
        <field name="implied_ids" eval="[
            Command.set([
                ref('group_garage_access_workshop'),
                ref('group_garage_access_stock'),
                ref('stock.group_stock_user'),
                ref('fleet.fleet_group_user'),
                ref('base.group_user')
            ])
        ]"/>
    </record>

    <!-- Profil 3 : Assistante / Agent d'Accueil (5 Modules Opérationnels) -->
    <record id="group_garage_receptionist" model="res.groups">
        <field name="name">Assistante / Agent d'Accueil</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_garage"/>
        <field name="implied_ids" eval="[
            Command.set([
                ref('group_garage_access_workshop'),
                ref('group_garage_access_insurance'),
                ref('group_garage_access_stock'),
                ref('group_garage_access_finance'),
                ref('group_garage_access_directory'),
                ref('stock.group_stock_user'),
                ref('fleet.fleet_group_user'),
                ref('base.group_user')
            ])
        ]"/>
    </record>

    <!-- Profil 4 : Gérant / Administrateur Garage (Tous les accès + Config & WhatsApp & Rentabilité) -->
    <record id="group_garage_manager" model="res.groups">
        <field name="name">Gérant / Responsable Garage</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_garage"/>
        <field name="implied_ids" eval="[
            Command.set([
                ref('group_garage_receptionist'),
                ref('group_garage_storekeeper'),
                ref('stock.group_stock_manager'),
                ref('fleet.fleet_group_manager'),
                ref('account.group_account_invoice')
            ])
        ]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>
</odoo>
